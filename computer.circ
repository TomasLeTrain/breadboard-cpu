    </comp>
    <comp lib="9" loc="(1870,1170)" name="Text">
      <a name="text" val="1 or chip, 1 inv (could be used for other things as well), 1 dec -&gt; 3 chips"/>
    </comp>
    <comp lib="9" loc="(1945,630)" name="Text">
      <a name="text" val="carry does not affect in logic modes, so can use sel0 as carry filter"/>
    </comp>
    <comp lib="9" loc="(2005,520)" name="Text">
      <a name="text" val="could have sel0 be direct and input carry into ucode rom"/>
    </comp>
    <comp lib="9" loc="(520,40)" name="Text">
      <a name="text" val="eq comp only works if carry in is high and subtract mode"/>
    </comp>
    <comp lib="9" loc="(860,1245)" name="Text">
      <a name="text" val="9 inverters, 1 nand, 3 ic's"/>
    </comp>
    <comp lib="9" loc="(910,1580)" name="Text">
      <a name="text" val="7 or, 1 inv, 3 chips (unless inv is around)"/>
    </comp>
    <comp lib="9" loc="(915,955)" name="Text">
      <a name="text" val="eq is open collector, can wire AND (?)"/>
