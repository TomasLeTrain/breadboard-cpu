// Adapted from https://github.com/ehsanmok/create-your-own-lang-with-rust/blob/master/thirdlang/src/grammar.pest

WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT    = _{ ";" ~ (!NEWLINE ~ ANY)* }

// Identifiers (variable/function names)
Identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Program is a sequence of statements/expressions
Program = _{ SOI ~ (Statement)* ~ EOI }

// Statements
Statement             = { LabelStatement | BlockLabel | InstructionStatement }

InstructionStatement  = { InstructionLabel ~ InstructionParameters? }
InstructionParameters = { InstructionParameter ~ ("," ~ InstructionParameter)* }
InstructionLabel      = { Identifier }
InstructionParameter  = _{  Expr }

LabelStatement = { Identifier ~ ":" }

BlockLabel = { Identifier ~ Block }

// Function definition: def name(params) { body }
Function =  { "fn" ~ Identifier ~ Block }
Params   = _{ Identifier ~ ("," ~ Identifier)* }

// Block: { statements }
Block = { "{" ~ Statement* ~ "}" }

// Expressions (ordered by precedence - lowest to highest)
Expr = { Comparison }

// Comparison operators
Comparison = { Additive ~ (CompOp ~ Additive)* }
CompOp     = { "<=" | ">=" | "<" | ">" | "==" | "!=" }

// Addition/Subtraction
Additive = { Multiplicative ~ (AddOp ~ Multiplicative)* }
AddOp    = { "+" | "-" }

// Multiplication/Division
Multiplicative = { Unary ~ (MulOp ~ Unary)* }
MulOp          = { "*" | "/" | "%" }

// Unary operators
Unary   = { UnaryOp ~ Unary | Primary }
UnaryOp = { "-" | "!" }

// Primary expressions
Primary = _{ Literal | Identifier | "(" ~ Expr ~ ")" }

// Literals
Literal =  { Bool | Int }
Int     = @{ ASCII_DIGIT+ }
Bool    = @{ "true" | "false" }
