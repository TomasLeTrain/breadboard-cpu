WHITESPACE = _{ " " | "\t" | NEWLINE }
COMMENT    = _{ ";" ~ (!NEWLINE ~ ANY)* }

// Program is a sequence of statements/expressions
Program = _{ SOI ~ (Statement)* ~ EOI }

// Statements
Statement             = { LabelStatement | BlockLabel | InstructionStatement }

InstructionStatement  = { InstructionLabel ~ InstructionParameters? }
InstructionParameters = { InstructionParameter ~ ("," ~ InstructionParameter)* }
InstructionLabel      = { Identifier }
InstructionParameter  = _{  Expr }

// label:
LabelStatement = { LabelIdentifier ~ ":" }

/// label { /* body (statements) */ }
BlockLabel = { LabelIdentifier ~ Block }

// atomic to avoid having to dig into identifier
LabelIdentifier = { Identifier }

Block = { "{" ~ Statement* ~ "}" }

// Arithmetic operators
add = { "+" }
subtract = { "-" }
multiply = { "*" }
divide = { "/" }
modulo = { "%" }
power = { "**" }

shift_left = { "<<" }
shift_right = { ">>" }
bit_and = { "&" }
bit_xor = { "^" }
bit_or = { "|" }


// Comparison operators
eq = { "==" }
ne = { "!=" }
le = { "<=" }  // Must come before "<" to avoid tokenizing "<=" as "<" + "=" in the `infix_op` rule later
ge = { ">=" }  // Must come before ">" to avoid tokenizing ">=" as ">" + "=" in the `infix_op` rule later
lt = { "<" }
gt = { ">" }

// Logical operators
logical_and = { "&&" }
logical_or = { "||" }

// Expression structure for Pratt parser
Expr = { prefix_op? ~ Primary ~ (infix_op ~ prefix_op? ~ Primary )* }

// All infix operations that the Pratt parser will handle
infix_op = _{
    add | subtract | multiply | divide | modulo | power |
    shift_left | shift_right | bit_and | bit_or |
    eq | ne | le | ge | lt | gt | logical_and | logical_or
}

prefix_op = _{ negation | bit_negation | logical_not }

// Unary operators
negation = { "-" }
bit_negation = { "~" }
logical_not = { "!" }

// Primary expressions
Primary = _{ Literal | Identifier | "(" ~ Expr ~ ")" }

// Literals
// Hex must have higher precedence otherwise gets recognized as int
Literal =  { Bool | Hexadecimal | Int  | String | Character }

Hexadecimal       = { ^"0x" ~ Int }

Int     = @{ ASCII_DIGIT+ }

Bool    = @{ "true" | "false" }
String = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }
Character = @{ "'" ~ ("\\"? ~ ANY) ~ "'" }

// Identifiers (variable/function names)
Identifier = @{ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
